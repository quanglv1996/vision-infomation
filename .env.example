# Copy to .env (next to docker-compose.yml) and adjust. Every MVC_* variable can
# also be set directly when running uvicorn (see backend/app/core/config.py).

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=vision
POSTGRES_PASSWORD=vision
POSTGRES_DB=vision

# ── Auth ──────────────────────────────────────────────────────────────────────
# Long random string; changing it signs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MVC_SECRET_KEY=change-me-in-production
# Created on first start if no account with this email exists (change the password after logging in).
MVC_ADMIN_EMAIL=admin@vision.local
MVC_ADMIN_PASSWORD=ChangeMe@123

# Public address of the frontend — used for links in emails.
MVC_FRONTEND_URL=http://localhost:5173

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Default: the bundled Mailpit catcher (http://localhost:8025), nothing leaves the machine.
# Gmail example (needs an App Password):
#   MVC_SMTP_HOST=smtp.gmail.com
#   MVC_SMTP_PORT=587
#   MVC_SMTP_STARTTLS=true
#   MVC_SMTP_USER=you@gmail.com
#   MVC_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
#   MVC_SMTP_FROM=Vision Studio <you@gmail.com>
MVC_SMTP_HOST=mailpit
MVC_SMTP_PORT=1025
